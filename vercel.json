{
  "version": 2,
  "functions": {
    "api/v1/[...path].js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1/[...path]?path=:path*"
    },
    {
      "source": "/reports",
      "destination": "/"
    },
    {
      "source": "/intel",
      "destination": "/"
    },
    {
      "source": "/intel-board",
      "destination": "/"
    },
    {
      "source": "/classic",
      "destination": "/"
    },
    {
      "source": "/geopolitical-risk-dashboard",
      "destination": "/"
    },
    {
      "source": "/osint-dashboard",
      "destination": "/"
    },
    {
      "source": "/strategic-intelligence-dashboard",
      "destination": "/"
    },
    {
      "source": "/personalized-intelligence-reports",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path":     "/api/v1/pipeline/run",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff"     },
        { "key": "X-Frame-Options",         "value": "DENY"        },
        { "key": "Referrer-Policy",         "value": "no-referrer" },
        { "key": "Cache-Control",           "value": "no-store"    },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    }
  ]
}
